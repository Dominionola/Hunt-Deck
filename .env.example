# ==========================================
# Hunt Deck — Environment Configuration Template
# ==========================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to Git.

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/huntdeck?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/huntdeck?schema=public"

# --- Authentication (Supabase Auth selected; integration pending) ---
# Legacy NextAuth placeholders; not the selected initial auth provider.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-char-random-secret"

# Supabase Auth (publishable key is client-safe; server keys are secrets)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only privileged key, optional; never expose it to browsers. Privileged access bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- Redis & Async Job Queue (BullMQ) ---
# Both the web process and the separately started `npm run worker:resume` process
# need the same durable Redis, private R2, database, and AI provider settings.
# Redis must persist jobs (AOF + appendfsync everysec, persistent disk) and use
# maxmemory-policy noeviction. Verify settings on the actual server.
REDIS_URL="redis://localhost:6379"
# Put any Redis password in REDIS_URL (rediss:// for TLS); REDIS_TOKEN is not used by this worker.
REDIS_TOKEN=""

# --- AI & LLM Providers ---
# Keep credentials server-side. Verify provider controls and model provenance
# before real documents. Gemini is for the wider writing workflow.
# 1. Google Gemini (Paid Tier Required) — Resume & Cover Letter Synthesis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# 2. Groq — High-Speed Structured Resume Entity Extraction
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# 3. Cloudflare Workers AI — 1,024-Dimensional Dense Vector Embeddings (@cf/baai/bge-m3)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_AI_API_TOKEN=""
CLOUDFLARE_EMBEDDING_MODEL="@cf/baai/bge-m3"
# Application generation label, not a provider-attested immutable model revision.
# Verify provenance before real data; re-embed both sides after model changes.
CLOUDFLARE_EMBEDDING_VERSION="1.0"

# Explicit fallback flags (Disabled by default; data-handling terms must be approved before enabling)
ALLOW_LEGACY_OPENAI_FALLBACK="false"
ALLOW_LEGACY_ANTHROPIC_FALLBACK="false"

# Anthropic (Claude 3.5 Sonnet — Resume Tailoring & Cover Letters)
ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# OpenAI (GPT-4o-mini for Extraction & text-embedding-3-large for Vectors)
OPENAI_API_KEY="sk-proj-your-key-here"

# --- Search & Intelligence APIs ---
# SerpAPI (Google Dork Crawler for Unadvertised Roles)
SERPAPI_API_KEY="your-serpapi-key-here"

# Hunter.io (Corporate Email Pattern Finder)
HUNTER_IO_API_KEY="your-hunter-io-api-key"

# Apollo.io (Secondary Contact Enrichment & Hiring Manager Discovery)
APOLLO_API_KEY="your-apollo-api-key"

# --- Cloudflare R2 / AWS S3 Object Storage (Resumes & Artifacts) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="huntdeck-resumes-dev"
# Must stay empty. Disable r2.dev and custom public domains on the actual bucket.
R2_PUBLIC_URL=""

# --- Email & Alerts (Resend selected; integration and verified domain pending) ---
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Hunt Deck Alerts <alerts@huntdeck.io>"

# --- Playwright Automation Worker ---
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_TIMEOUT_MS="30000"
PLAYWRIGHT_SLOW_MO_MS="50"
