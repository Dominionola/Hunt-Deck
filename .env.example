# ==========================================
# Hunt Deck — Environment Configuration Template
# ==========================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to Git.

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/huntdeck?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/huntdeck?schema=public"

# --- Authentication (Supabase Auth selected; integration pending) ---
# Legacy NextAuth placeholders; not the selected initial auth provider.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-char-random-secret"

# Supabase Auth (publishable key is client-safe; server keys are secrets)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only privileged key, optional; never expose it to browsers. Privileged access bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- Redis & Async Job Queue (BullMQ) ---
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN="your-upstash-redis-token-if-using-cloud"

# --- AI & LLM Providers ---
# Anthropic (Claude 3.5 Sonnet — Resume Tailoring & Cover Letters)
ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# OpenAI (GPT-4o-mini for Extraction & text-embedding-3-large for Vectors)
OPENAI_API_KEY="sk-proj-your-key-here"

# --- Search & Intelligence APIs ---
# SerpAPI (Google Dork Crawler for Unadvertised Roles)
SERPAPI_API_KEY="your-serpapi-key-here"

# Hunter.io (Corporate Email Pattern Finder)
HUNTER_IO_API_KEY="your-hunter-io-api-key"

# Apollo.io (Secondary Contact Enrichment & Hiring Manager Discovery)
APOLLO_API_KEY="your-apollo-api-key"

# --- Cloudflare R2 / AWS S3 Object Storage (Resumes & Artifacts) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="huntdeck-resumes-dev"
# Legacy public URL placeholder only: never configure a public bucket for resumes.
# The current storage service still uses this field; private signed access must be implemented first.
R2_PUBLIC_URL=""

# --- Email & Alerts (Resend selected; integration and verified domain pending) ---
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Hunt Deck Alerts <alerts@huntdeck.io>"

# --- Playwright Automation Worker ---
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_TIMEOUT_MS="30000"
PLAYWRIGHT_SLOW_MO_MS="50"
