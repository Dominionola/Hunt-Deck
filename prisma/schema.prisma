// Hunt Deck — Master Database Schema
// PostgreSQL 16 + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  USER
  ADMIN
  ENTERPRISE
}

enum RemotePreference {
  REMOTE_ONLY
  HYBRID
  ONSITE
  ANY
}

enum AtsPlatform {
  GREENHOUSE
  LEVER
  ASHBY
  WORKDAY
  OTHER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

enum ContactSource {
  HUNTER
  APOLLO
  LINKEDIN
  DIRECT
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. User & Authentication
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  authSubject  String?       @unique @db.Uuid
  email        String        @unique
  name         String?
  passwordHash String?
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  profile      Profile?
  resumes      Resume[]
  applications Application[]

  @@map("users")
}

model Profile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  headline            String?
  targetTitles        String[]         @default([])
  minSalary           Int?
  maxSalary           Int?
  preferredLocations  String[]         @default([])
  remotePreference    RemotePreference @default(ANY)
  experienceYears     Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Resumes & Vector Embeddings
// ─────────────────────────────────────────────────────────────────────────────

model Resume {
  id              String         @id @default(cuid())
  userId          String
  title           String         @default("Master Resume")
  originalFileUrl String
  extractedText   String         @db.Text
  parsedData      Json           // Structured skills, experience, education, projects
  embedding       Unsupported("vector(1536)")? // Legacy 1536-dim vector
  embedding1024   Unsupported("vector(1024)")? // Cloudflare Workers AI @cf/baai/bge-m3
  embeddingModel  String?        @db.VarChar(100) // Model identifier
  embeddingVersion String?       @db.VarChar(50)  // Model version
  contentHash     String?        @db.VarChar(64)  // SHA-256 hash of normalized text
  embeddedAt      DateTime?      @db.Timestamptz(6)
  atsScore        Int?
  isPrimary       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  fitScores       JobFitScore[]

  @@index([contentHash, embeddingModel, embeddingVersion], map: "idx_resumes_content_hash")
  @@map("resumes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Job Postings & Discovery
// ─────────────────────────────────────────────────────────────────────────────

model JobPosting {
  id             String         @id @default(cuid())
  title          String
  company        String
  description    String         @db.Text
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  remoteType     RemotePreference @default(ANY)
  atsPlatform    AtsPlatform    @default(OTHER)
  applicationUrl String
  externalJobId  String?
  embedding      Unsupported("vector(1536)")? // Legacy 1536-dim vector
  embedding1024  Unsupported("vector(1024)")? // Cloudflare Workers AI @cf/baai/bge-m3
  embeddingModel String?         @db.VarChar(100) // Model identifier
  embeddingVersion String?       @db.VarChar(50)  // Model version
  contentHash    String?         @db.VarChar(64)  // SHA-256 hash of normalized text
  embeddedAt     DateTime?       @db.Timestamptz(6)
  postedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sourceDorkId   String?
  sourceDork     DorkDiscoverySession? @relation(fields: [sourceDorkId], references: [id], onDelete: SetNull)
  fitScores      JobFitScore[]
  applications   Application[]
  sourceRecords  JobSourceRecord[]

  @@unique([company, title, applicationUrl])
  @@index([contentHash, embeddingModel, embeddingVersion], map: "idx_jobs_content_hash")
  @@map("job_postings")
}

// Import state is source-scoped; a fenced run must finish verification before
// missing source records can be marked closed. Existing job history is kept.
model JobSource {
  id          String            @id @default(cuid())
  platform    AtsPlatform
  board       String
  generation  Int               @default(0)
  runs        JobSourceRun[]
  records     JobSourceRecord[]
  @@unique([platform, board])
  @@map("job_sources")
}

// Draft: reviewed sources are scheduled only after the related migration is approved.
model JobSourceSchedule {
  id            String      @id
  platform      AtsPlatform
  board         String
  approvedBy    String
  enabled       Boolean     @default(true)
  nextRunAt     DateTime    @db.Timestamptz(6)
  intervalHours Int         @default(24)
  reviewedAt    DateTime    @db.Timestamptz(6)

  @@unique([platform, board])
  @@index([enabled, nextRunAt])
  @@map("job_source_schedules")
}

model JobSourceRun {
  id            String    @id @default(cuid())
  sourceId      String
  generation    Int
  state         String    @default("collecting")
  nextOffset    Int       @default(0)
  invalidCount  Int       @default(0)
  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt    DateTime? @db.Timestamptz(6)
  source        JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  observations  JobSourceObservation[]
  @@unique([sourceId, generation])
  @@index([sourceId, state])
  @@map("job_source_runs")
}

model JobSourceObservation {
  runId      String
  pass       Int
  externalId String
  run        JobSourceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@id([runId, pass, externalId])
  @@map("job_source_observations")
}

model JobSourceRecord {
  sourceId       String
  externalId     String
  jobId          String
  lastGeneration Int
  closedAt       DateTime? @db.Timestamptz(6)
  source         JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  job            JobPosting @relation(fields: [jobId], references: [id], onDelete: Restrict)
  @@id([sourceId, externalId])
  @@index([jobId])
  @@map("job_source_records")
}

model JobFitScore {
  id               String       @id @default(cuid())
  resumeId         String
  jobId            String
  overallScore     Float        // 0.0 - 100.0
  skillsScore      Float        // 40% weight
  experienceScore  Float        // 30% weight
  titleScore       Float        // 20% weight
  locationScore    Float        // 10% weight
  missingKeywords  String[]     @default([])
  matchingKeywords String[]     @default([])
  calculatedAt     DateTime     @default(now())

  resume           Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job              JobPosting   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId])
  @@map("job_fit_scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Applications & Kanban Tracker
// ─────────────────────────────────────────────────────────────────────────────

model Application {
  id              String            @id @default(cuid())
  userId          String
  jobId           String
  resumeId        String
  status          ApplicationStatus @default(SAVED)
  tailoredResumeUrl String?
  coverLetterText String?           @db.Text
  appliedAt       DateTime?
  followUpDate    DateTime?
  interviewNotes  String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume          Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Google Dork Discovery & Contact Intelligence
// ─────────────────────────────────────────────────────────────────────────────

model DorkDiscoverySession {
  id           String       @id @default(cuid())
  query        String
  dorkType     String       // "greenhouse", "lever", "ashby", "startup_career"
  resultsFound Int          @default(0)
  status       String       @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  createdAt    DateTime     @default(now())

  jobs         JobPosting[]

  @@map("dork_discovery_sessions")
}

model CompanyContact {
  id              String        @id @default(cuid())
  companyName     String
  fullName        String
  title           String
  email           String?
  emailConfidence Float?        // 0.0 - 100.0
  linkedinUrl     String?
  department      String?
  source          ContactSource @default(HUNTER)
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([companyName, fullName, title])
  @@map("company_contacts")
}
